# Cortex Application Configuration

# Environment
FLASK_ENV=development
HOST=0.0.0.0
PORT=5050

# API Keys (optional - for future enhancements)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional literature database keys. Leave blank to skip these sources -
# Europe PMC, CrossRef, arXiv, ERIC, and Semantic Scholar work with no key.
# ELSEVIER_API_KEY: register free at https://dev.elsevier.com (covers Scopus + ScienceDirect)
# WOS_API_KEY: Web of Science Starter/Expanded API, via your institution's Clarivate access
# SEMANTIC_SCHOLAR_API_KEY: register free at https://www.semanticscholar.org/product/api (raises rate limits)
ELSEVIER_API_KEY=
WOS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Logging
LOG_LEVEL=INFO

# Application Settings
MAX_IDEA_LENGTH=500
MIN_IDEA_LENGTH=10
API_TIMEOUT=30
API_RATE_LIMIT=100
