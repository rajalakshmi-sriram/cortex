{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex",
  "version": "1.0.0",
  "identifier": "com.cortex.researchworkspace",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/cortex-backend": "cortex-backend"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
